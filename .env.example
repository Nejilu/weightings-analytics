# Durable local SQLite database. Relative paths resolve from the project root.
DATABASE_PATH=.data/weightings-analytics.sqlite
DRIZZLE_MIGRATIONS_PATH=drizzle

# One main branch, two runtime modes. Local works without login, including builds.
# Without access settings the default is local. Local requests require loopback hosts.
SITE_ACCESS_MODE=local
BIND_HOST=127.0.0.1

# Web deployment: set SITE_ACCESS_MODE=cloudflare and configure all values below.
# Docker/systemd explicitly select cloudflare; missing/invalid settings deny access.
# SITE_PUBLIC_ORIGIN=https://pf.nejilu.com
# SITE_OWNER_ORIGIN=https://admin-pf.nejilu.com
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience
# SITE_OWNER_EMAIL=owner@example.com

# Optional development preview: localhost is the owner and 127.0.0.1 the visitor.
# SITE_LOCAL_PUBLIC_PREVIEW=true

# Optional: override the default 24-hour source cache.
HOLDINGS_CACHE_TTL_SECONDS=86400

# Optional: override the default 24-hour market-price and FX cache.
MARKET_PRICE_TTL_SECONDS=86400
MARKET_PRICE_CONCURRENCY=4
HOLDINGS_REFRESH_CONCURRENCY=4

# Optional: TradingView Screener metrics cache and grouped request size.
TRADINGVIEW_METRICS_TTL_SECONDS=86400
TRADINGVIEW_METRICS_MISSING_TTL_SECONDS=900
TRADINGVIEW_BATCH_SIZE=1000
TRADINGVIEW_MISSING_RETRY_LIMIT=100
TRADINGVIEW_ESTIMATES_BATCH_SIZE=250
TRADINGVIEW_ESTIMATES_CONCURRENCY=5
TRADINGVIEW_ESTIMATES_MISSING_TTL_SECONDS=900

# Refresh source observations for saved portfolios once per day (Europe/Paris).
# No aggregate results are stored, and unrelated catalog ETFs are not scanned.
PORTFOLIO_METRICS_DAILY_REFRESH=true

# Optional: only configure when this server cannot reach iShares/BlackRock directly.
# ISHARES_RELAY_URL=https://your-relay.your-account.workers.dev/

# Optional AI analysis: existing T3/Codex connection, configured only on the backend.
# Run scripts/connect-ai-t3.mjs on the T3 host first; see docs/ai-analysis.md.
# T3_BASE_URL=http://127.0.0.1:3773
# T3_AUTH_TOKEN_FILE=/absolute/path/to/protected/t3-backend-token
# T3_PROVIDER_INSTANCE=weightings-analysis
# T3_PROJECT_ID=weightings-analysis
