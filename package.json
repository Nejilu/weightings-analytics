{
  "name": "weightings-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "prestart": "npm run db:setup",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-processors.ts && node scripts/audit-tradingview-mappings.test.mjs && npm run test:migrations && node --test scripts/start-standalone-assets.test.mjs && npm run test:ai && npm run test:site && npm run test:holdings && npm run test:stock && npm run test:portfolio-events && npm run test:portfolio-clone && npm run test:portfolio-history && npm run test:portfolio-journal && npm run test:dividends && npm run test:metrics && npm run test:prices",
    "test:prices": "node --conditions=react-server --import tsx --test src/domain/async-utils.test.ts src/domain/market-quote.test.ts src/data/providers/tradingview-quotes.test.ts src/data/services/market-price-service.test.ts src/db/repositories/market-price-repository.test.ts",
    "test:prices:live": "node --conditions=react-server --import tsx scripts/test-market-quotes.ts",
    "test:metrics": "node --conditions=react-server --import tsx --test src/data/services/metrics-source-refresh.test.ts src/data/services/portfolio-metrics-refresh-service.test.ts src/data/providers/tradingview-estimates-coordinator.test.ts",
    "test:stock": "node --conditions=react-server --import tsx --test src/data/services/stock-metrics-service.test.ts src/data/services/adr-premium-service.test.ts src/domain/adr-premium.test.ts src/data/providers/tradingview-chart.test.ts src/components/dashboard/adr-premium-store.test.ts",
    "test:portfolio-history": "node --conditions=react-server --import tsx --test src/domain/portfolio-history.test.ts src/domain/portfolio-dashboard.test.ts src/data/services/portfolio-history-service.test.ts src/data/services/portfolio-hourly-history.test.ts",
    "test:portfolio-journal": "node --conditions=react-server --import tsx --test src/domain/portfolio-journal.test.ts src/data/services/portfolio-journal-service.test.ts",
    "test:dividends": "node --conditions=react-server --import tsx --test src/domain/dividends.test.ts src/data/services/portfolio-dividends-service.test.ts",
    "test:migrations": "node scripts/test-migrations.mjs && node --import tsx --test src/db/branch-upgrade.test.ts",
    "test:portfolio": "tsx src/domain/processors/analyze-portfolio.test.ts && npm run test:portfolio-clone",
    "test:portfolio-clone": "node --conditions=react-server --import tsx --test src/domain/portfolio-clone.test.ts src/data/services/portfolio-clone-service.test.ts",
    "test:portfolio-events": "node --conditions=react-server --import tsx --test src/domain/portfolio-events.test.ts src/data/services/portfolio-events-service.test.ts",
    "test:tradingview": "tsx scripts/test-tradingview-estimates.ts",
    "test:tradingview-estimates": "tsx scripts/test-tradingview-estimates.ts",
    "test:mappings-audit": "node scripts/audit-tradingview-mappings.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:sync-samsung": "tsx scripts/sync-samsung-securities.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:stats": "tsx scripts/db-stats.ts",
    "db:audit-mappings": "node scripts/audit-tradingview-mappings.mjs",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:import-tradingview-mappings": "tsx scripts/import-tradingview-mappings.ts",
    "test:site": "node --conditions=react-server --import tsx --test src/server/site.test.ts src/server/public-portfolio-journal.test.ts",
    "test:holdings": "node --conditions=react-server --import tsx --test src/data/services/holdings-refresh.test.ts && node --test deploy/ishares-relay/worker.test.mjs",
    "test:ai": "node --conditions=react-server --import tsx --test src/server/ai-analysis.test.ts && node --test scripts/renew-ai-t3.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "yahoo-finance2": "^4.0.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.9.0"
  }
}
